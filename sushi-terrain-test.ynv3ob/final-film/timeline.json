      "card": {
        "eyebrow": "行迹档案 · 005",
        "subtitle": "北宋 · 熙宁四年至七年",
        "lines": [
          "因议论新法不合，",
          "自请外任，通判杭州。",
          "西湖山水，",
          "第一次收留了他的失意。"
        ]
      },
      "quote": {
        "after_s": 6,
        "title": "饮湖上初晴后雨",
        "lines": [
          "欲把西湖比西子，",
          "淡妆浓抹总相宜。"
        ],
        "source": "熙宁六年 · 杭州",
        "year": 1073
      },
      "narration": [
        {
          "start": 0.8,
          "text": "熙宁四年，因议论新法不合，苏轼自请外任，来到杭州。西湖让他暂时远离朝堂，也让他的诗词有了另一种开阔。"
        },
        {
          "after_arrival": 6.8,
          "text": "欲把西湖比西子，淡妆浓抹总相宜。"
        }
      ],
      "arrival_year": 1071
    },
    {
      "id": "mizhou",
      "index": "06",
      "title": "密州知州",
      "place": "密州",
      "year_start": 1071,
      "year_end": 1076,
      "travel_s": 6,
      "hold_s": 16,
      "waypoints": [
