      "quote": {
        "after_s": 2.5,
        "title": "食荔枝",
        "lines": [
          "日啖荔枝三百颗，",
          "不辞长作岭南人。"
        ],
        "source": "绍圣三年 · 惠州",
        "year": 1096
      },
      "narration": [
        {
          "start": 0.8,
          "text": "绍圣元年，苏轼被贬惠州。岭南路远，亲友离散，他仍种药、酿酒、修桥，认真安排眼前的生活。"
        },
        {
          "after_arrival": 3.2,
          "text": "日啖荔枝三百颗，不辞长作岭南人。诗句写得轻快，背后却是一次没有归期的放逐。"
        }
      ],
      "asset_caption": "惠州东坡纪念馆 · 现代建筑"
