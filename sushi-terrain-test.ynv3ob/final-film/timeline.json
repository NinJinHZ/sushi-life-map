      "card": {
        "eyebrow": "行迹档案 · 006",
        "subtitle": "北宋 · 熙宁七年至九年",
        "lines": [
          "从江南到山东，",
          "第一次做了一州长官。",
          "捕蝗、赈饥、收养弃婴，",
          "也写下最明亮的怀人之词。"
        ]
      },
      "quote": {
        "after_s": 6.2,
        "title": "水调歌头 · 明月几时有",
        "lines": [
          "但愿人长久，",
          "千里共婵娟。"
        ],
        "source": "熙宁九年 · 密州",
        "year": 1076
      },
      "narration": [
        {
          "start": 0.8,
          "text": "三年后，他北上密州，第一次成为一州知州。捕蝗、赈饥、救助弃婴，日子的艰难，让他更靠近百姓。"
        },
        {
          "after_arrival": 7.0,
          "text": "熙宁九年中秋，他想念远在济南的苏辙，写下：但愿人长久，千里共婵娟。"
        }
      ],
      "arrival_year": 1074
    },
